{
  "name": "qi-dashboard-server",
  "version": "1.0.0",
  "description": "Fall & HAPI Prevention QI Dashboard — server with separate volunteer/admin logins",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "build:client": "esbuild client/src/main.jsx --bundle --outfile=public/bundle.js --loader:.js=jsx --minify --target=es2019",
    "build:css": "tailwindcss -i ./input.css -o ./public/styles.css --minify",
    "build": "npm run build:client && npm run build:css"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.27.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3"
  }
}
